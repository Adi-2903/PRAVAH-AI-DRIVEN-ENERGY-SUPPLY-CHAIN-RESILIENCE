# ─────────────────────────────────────────────────────────────
# PRAVAH frontend — API endpoint configuration
# Copy to `.env.local` and adjust as needed. All keys are build-time
# public (NEXT_PUBLIC_*) because the browser calls these services directly.
# ─────────────────────────────────────────────────────────────
#
# DEFAULTS below match docker-compose.yml host port mappings:
#   procurement-agent -> 8003   scenario-engine -> 8002
#   spr-agent         -> 8004   risk-agent      -> 8001
#   coordinator       -> 8005
#
# If you run a SINGLE agent standalone (uvicorn defaults to :8000), point the
# relevant URL at :8000 for that one, e.g. NEXT_PUBLIC_SCENARIO_URL=http://127.0.0.1:8000
#
# For a deployed frontend (Vercel), set these to the public service URLs.

NEXT_PUBLIC_RISK_URL="http://127.0.0.1:8001"
NEXT_PUBLIC_SCENARIO_URL="http://127.0.0.1:8002"
NEXT_PUBLIC_PROCUREMENT_URL="http://127.0.0.1:8003"
NEXT_PUBLIC_SPR_URL="http://127.0.0.1:8004"
NEXT_PUBLIC_COORDINATOR_URL="http://127.0.0.1:8005"
